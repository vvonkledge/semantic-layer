# SHACL shapes for the L1 business layer.
#
# Every shape carries a message written for the person who tripped it, because the
# message is the only part of a shape anybody reads. Each shape has a matching
# negative fixture under ontology/instances/fixtures/invalid/ that asserts the exact
# message, so a shape cannot silently stop enforcing.
#
# Validation is a batch pass over a finished graph, never a write-time check. The
# authorization rule below is the reason: a graph is assembled edge by edge, and the
# same valid graph is invalid halfway through, depending only on arrival order.

@prefix biz:  <https://semantic-layer.19h09.co/vocab/biz#> .
@prefix core: <https://semantic-layer.19h09.co/vocab/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix shp:  <https://semantic-layer.19h09.co/shapes/biz#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://semantic-layer.19h09.co/shapes/biz>
    a owl:Ontology ;
    rdfs:label "Semantic layer business shapes (L1)" ;
    owl:versionInfo "0.2.0" ;
    sh:declare [ sh:prefix "biz"  ; sh:namespace "https://semantic-layer.19h09.co/vocab/biz#"^^xsd:anyURI ] ,
               [ sh:prefix "core" ; sh:namespace "https://semantic-layer.19h09.co/vocab/core#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf"  ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "owl"  ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .

## Capability: ownership and goal linkage.

shp:CapabilityShape
    a sh:NodeShape ;
    sh:targetClass biz:Capability ;

    sh:property [
        sh:path biz:ownedBy ;
        sh:minCount 1 ;
        sh:message "Capability {$this} has no owner. Unowned work is unassignable: nobody can authorize it and nobody answers for it." ;
    ] ;

    sh:property [
        sh:path biz:ownedBy ;
        sh:maxCount 1 ;
        sh:message "Capability {$this} has more than one owner. Accountability is singular; split the capability instead of splitting its ownership." ;
    ] ;

    sh:property [
        sh:path biz:ownedBy ;
        sh:class biz:Actor ;
        sh:message "Capability {$this} is owned by {?value}, which is not an Actor. Ownership lands on a person, a team or an agent identity." ;
    ] ;

    sh:property [
        sh:path biz:supports ;
        sh:class biz:Goal ;
        sh:message "Capability {$this} supports {?value}, which is not a Goal. A capability contributes to outcomes, not to other capabilities." ;
    ] .

## Authorization: roles are granted to actors, roles permit capabilities.

shp:ActorShape
    a sh:NodeShape ;
    sh:targetClass biz:Actor ;

    sh:property [
        sh:path biz:grantsRole ;
        sh:class biz:Role ;
        sh:message "Actor {$this} is granted {?value}, which is not a Role. Authorization flows actor to role to capability, and nowhere else." ;
    ] .

shp:RoleShape
    a sh:NodeShape ;
    sh:targetClass biz:Role ;

    sh:property [
        sh:path biz:permits ;
        sh:class biz:Capability ;
        sh:message "Role {$this} permits {?value}, which is not a Capability. A role permits what may be done, not who may do it." ;
    ] .

## Assignment: complete, well-aimed, and authorized.

shp:AssignmentShape
    a sh:NodeShape ;
    sh:targetClass biz:Assignment ;

    sh:property [
        sh:path biz:assignedTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Assignment {$this} must name exactly one agent identity with biz:assignedTo. Work nobody is named for cannot be attributed afterwards." ;
    ] ;

    sh:property [
        sh:path biz:assignedTo ;
        sh:class biz:AgentIdentity ;
        sh:message "Assignment {$this} is assigned to {?value}, which is not an AgentIdentity. Assignments are given to agents; people and teams own capabilities instead." ;
    ] ;

    sh:property [
        sh:path biz:targetsCapability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Assignment {$this} must name exactly one capability with biz:targetsCapability. Without it there is nothing to authorize the assignee against." ;
    ] ;

    sh:property [
        sh:path biz:targetsCapability ;
        sh:class biz:Capability ;
        sh:message "Assignment {$this} targets {?value}, which is not a Capability." ;
    ] ;

    sh:property [
        sh:path biz:servesGoal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Assignment {$this} must name exactly one goal with biz:servesGoal. Work with no stated outcome cannot be prioritized, judged or stopped for a reason." ;
    ] ;

    sh:property [
        sh:path biz:servesGoal ;
        sh:class biz:Goal ;
        sh:message "Assignment {$this} serves {?value}, which is not a Goal." ;
    ] ;

    sh:property [
        sh:path biz:governedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Assignment {$this} must name exactly one governing policy with biz:governedBy. An agent may not act under an unstated policy." ;
    ] ;

    sh:property [
        sh:path biz:governedBy ;
        sh:class biz:Policy ;
        sh:message "Assignment {$this} is governed by {?value}, which is not a Policy." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Assignment {$this} assigns {?agent} to capability {?capability}, but {?agent} holds no role permitting it. Authorization is not implied by being asked." ;
        sh:prefixes <https://semantic-layer.19h09.co/shapes/biz> ;
        sh:select """
            SELECT $this ?agent ?capability
            WHERE {
                $this biz:assignedTo ?agent ;
                      biz:targetsCapability ?capability .
                FILTER NOT EXISTS { ?agent biz:grantsRole/biz:permits ?capability }
            }
        """ ;
    ] .

## The L1 boundary: business truth never names a system.
#
# A business node may carry only properties defined by the core or business
# vocabulary, plus the standard annotations below. Anything else - a hostname, a
# repository, an environment - is an L2 fact, and an L2 fact in L1 gives business
# truth an expiry date it has no way to honour. Adding a term to the vocabulary is
# how the allowance grows; there is no separate list to keep in step.
#
# The GRAPH clause is what makes that true rather than merely intended. SHACL judges
# one graph and cannot see where a triple came from, so if the vocabulary were merged
# flat into the data under validation, an instance file asserting
# `tech:productionEndpoint rdfs:isDefinedBy <.../vocab/biz>` would be granting itself
# the allowance and this constraint would agree. Asking inside the vocabulary's own
# named graph means only the vocabulary can answer, and an instance file cannot reach
# that graph: Turtle has no syntax for naming one. See graph.data_graph.

shp:L1BoundaryShape
    a sh:NodeShape ;
    sh:targetClass biz:Goal , biz:Capability , biz:Actor , biz:Role , biz:Policy , biz:Assignment ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "L1 node {$this} asserts {?property}, which no L1 vocabulary defines. Technical facts - services, repositories, environments, endpoints - belong to L2 and never enter L1." ;
        sh:prefixes <https://semantic-layer.19h09.co/shapes/biz> ;
        sh:select """
            SELECT $this ?property
            WHERE {
                $this ?property ?object .
                FILTER NOT EXISTS {
                    GRAPH ?vocabulary { ?property rdfs:isDefinedBy ?vocabulary }
                    FILTER ( ?vocabulary IN (
                        <https://semantic-layer.19h09.co/vocab/core> ,
                        <https://semantic-layer.19h09.co/vocab/biz>
                    ) )
                }
                FILTER ( ?property NOT IN (
                    rdf:type , rdfs:label , rdfs:comment , rdfs:seeAlso , owl:deprecated
                ) )
            }
        """ ;
    ] .

## Retirement: an identifier is deprecated, never reused and never deleted.

shp:SupersessionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf core:supersedes ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "{$this} supersedes {?superseded}, which is not marked owl:deprecated true. A retired identifier stays in the graph, deprecated, so references held elsewhere keep resolving." ;
        sh:prefixes <https://semantic-layer.19h09.co/shapes/biz> ;
        sh:select """
            SELECT $this ?superseded
            WHERE {
                $this core:supersedes ?superseded .
                FILTER NOT EXISTS { ?superseded owl:deprecated true }
            }
        """ ;
    ] .
