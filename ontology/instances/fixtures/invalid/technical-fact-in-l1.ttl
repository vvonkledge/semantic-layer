# A repository name on a business capability. The moment L1 knows a system, business
# truth has an expiry date it cannot honour.
@prefix tech: <https://example.org/some-technical-vocabulary#> .

cap:payment-processing
    a biz:Capability ;
    rdfs:label "Payment processing" ;
    biz:ownedBy team:payments ;
    tech:sourceRepository "git@example.org:payments/gateway.git" .

team:payments a biz:Team ; rdfs:label "Payments team" .
