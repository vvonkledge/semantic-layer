# TEST FIXTURE - NOT ORGANIZATIONAL TRUTH.
# A deliberate violation of exactly one constraint. See tests/test_negative_fixtures.py.

@prefix biz:      <https://semantic-layer.19h09.co/vocab/biz#> .
@prefix core:     <https://semantic-layer.19h09.co/vocab/core#> .
@prefix goal:     <https://semantic-layer.19h09.co/fixture/biz/goal/> .
@prefix cap:      <https://semantic-layer.19h09.co/fixture/biz/capability/> .
@prefix team:     <https://semantic-layer.19h09.co/fixture/biz/team/> .
@prefix agent:    <https://semantic-layer.19h09.co/fixture/biz/agent/> .
@prefix role:     <https://semantic-layer.19h09.co/fixture/biz/role/> .
@prefix policy:   <https://semantic-layer.19h09.co/fixture/biz/policy/> .
@prefix asg:      <https://semantic-layer.19h09.co/fixture/biz/assignment/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .

# Governed by a role. A role says what may be done; it places no constraint on how, so
# this assignment is running under no rule at all.
asg:governed-by-a-role
    a biz:Assignment ;
    rdfs:label "Work governed by a role instead of a policy" ;
    biz:assignedTo agent:remediator ;
    biz:targetsCapability cap:payment-processing ;
    biz:servesGoal goal:checkout-reliability ;
    biz:governedBy role:service-maintainer .

agent:remediator a biz:AgentIdentity ; rdfs:label "Remediation agent" ;
    biz:grantsRole role:service-maintainer .
role:service-maintainer a biz:Role ; rdfs:label "Service maintainer" ;
    biz:permits cap:payment-processing .
cap:payment-processing a biz:Capability ; rdfs:label "Payment processing" ;
    biz:ownedBy team:payments .
goal:checkout-reliability a biz:Goal ; rdfs:label "Checkout reliability" .
policy:production-change-review a biz:Policy ; rdfs:label "Production change review" .
team:payments a biz:Team ; rdfs:label "Payments team" .
