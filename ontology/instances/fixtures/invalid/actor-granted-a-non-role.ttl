# Granted a policy. A policy constrains how work is done; it confers nothing, so this
# actor is left holding a permission that permits nothing.
team:payments
    a biz:Team ;
    rdfs:label "Payments team" ;
    biz:grantsRole policy:production-change-review .

policy:production-change-review a biz:Policy ; rdfs:label "Production change review" .
