# TEST FIXTURE - NOT ORGANIZATIONAL TRUTH.
# A deliberate violation of exactly one constraint. See tests/test_negative_fixtures.py.

@prefix biz:      <https://semantic-layer.19h09.co/vocab/biz#> .
@prefix core:     <https://semantic-layer.19h09.co/vocab/core#> .
@prefix goal:     <https://semantic-layer.19h09.co/fixture/biz/goal/> .
@prefix cap:      <https://semantic-layer.19h09.co/fixture/biz/capability/> .
@prefix team:     <https://semantic-layer.19h09.co/fixture/biz/team/> .
@prefix agent:    <https://semantic-layer.19h09.co/fixture/biz/agent/> .
@prefix role:     <https://semantic-layer.19h09.co/fixture/biz/role/> .
@prefix policy:   <https://semantic-layer.19h09.co/fixture/biz/policy/> .
@prefix asg:      <https://semantic-layer.19h09.co/fixture/biz/assignment/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .

# The same breach as technical-fact-in-l1.ttl, attempted the other way round: rather
# than adding a technical term to the business vocabulary - a conspicuous edit to a
# small, reviewed file - this file declares the term L1 itself, in the graph the
# boundary shape is about to read.
#
# It does not work, and the reason is provenance, not cleverness. The vocabularies are
# loaded into named graphs of their own and the boundary shape asks inside them, so
# only a vocabulary can say what a vocabulary defines. See graph.data_graph.
@prefix tech: <https://example.org/some-technical-vocabulary#> .

tech:productionEndpoint rdfs:isDefinedBy <https://semantic-layer.19h09.co/vocab/biz> .

cap:payment-processing
    a biz:Capability ;
    rdfs:label "Payment processing" ;
    biz:ownedBy team:payments ;
    tech:productionEndpoint "https://payments.prod.example.org/v2" .

team:payments a biz:Team ; rdfs:label "Payments team" .
