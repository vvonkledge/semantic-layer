# Two teams, each believing the other is answering for it.
cap:shared-reporting
    a biz:Capability ;
    rdfs:label "Shared reporting" ;
    biz:ownedBy team:payments , team:risk .

team:payments a biz:Team ; rdfs:label "Payments team" .
team:risk     a biz:Team ; rdfs:label "Risk team" .
