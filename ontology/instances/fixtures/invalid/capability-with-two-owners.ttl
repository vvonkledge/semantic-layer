@prefix biz:      <https://semantic-layer.19h09.co/vocab/biz#> .
@prefix core:     <https://semantic-layer.19h09.co/vocab/core#> .
@prefix goal:     <https://semantic-layer.19h09.co/fixture/biz/goal/> .
@prefix cap:      <https://semantic-layer.19h09.co/fixture/biz/capability/> .
@prefix team:     <https://semantic-layer.19h09.co/fixture/biz/team/> .
@prefix agent:    <https://semantic-layer.19h09.co/fixture/biz/agent/> .
@prefix role:     <https://semantic-layer.19h09.co/fixture/biz/role/> .
